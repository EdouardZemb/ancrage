{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/modele/lancer.sh\" \"$CLAUDE_PROJECT_DIR/scripts/modele/garde_claude.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Monitor|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/cours-absent.ts\" --hook",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/modele/lancer.sh\" \"$CLAUDE_PROJECT_DIR/scripts/modele/signaux.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
