{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/.superpowers",
      "!**/.claude",
      "!**/.github/modele",
      "!**/.local",
      "!**/node_modules",
      "!**/dist",
      "!**/dist-e2e",
      "!**/coverage",
      "!**/playwright-report",
      "!**/test-results",
      "!**/reports",
      "!**/.stryker-tmp",
      "!**/src/serveur/base/migrations",
      "!instance",
      "!exemple-contenu"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "markdown": {
    "formatter": {
      "enabled": false
    },
    "linter": {
      "enabled": false
    }
  },
  "yaml": {
    "formatter": {
      "enabled": false
    },
    "linter": {
      "enabled": false
    }
  },
  "linter": {
    "enabled": true
  }
}
