{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "src",
    "e2e",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.mutation.config.ts",
    "scripts/cours-absent.ts",
    "scripts/cours-absent.test.ts",
    "playwright.config.ts",
    "playwright.mise-a-jour.config.ts"
  ],
  "exclude": ["src/client/sw.ts"]
}
